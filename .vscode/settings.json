{
  "[html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  },
  "[django-html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  },
  "[jinja-html]": {
    "editor.defaultFormatter": "monosans.djlint",
    "editor.formatOnSave": true
  },
  "files.associations": {
    "**/templates/**/*.html": "jinja-html"
  },
  "djlint.showInstallError": false,
  "liveServer.settings.port": 5501
}
